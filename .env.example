# ── Minecraft server ──────────────────────────────────────────────────────
# Enable RCON in server.properties first:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=<the same value as below>
RCON_PASSWORD=change-me
MC_HOST=127.0.0.1
MC_PORT=25565
RCON_PORT=25575
MC_USERNAME=mcAI

# ── AI provider (optional) ────────────────────────────────────────────────
# Easier: run `./mcai setup`, or use the dashboard's "AI provider" button.
# Anything set here wins over what setup saved, which is what keeps Docker
# and CI working with no config file. Without any of it, the fifteen library
# structures still build.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_HOST=http://127.0.0.1:1234

# Or point at anything OpenAI-compatible:
# MCAI_PROVIDER=custom
# MCAI_BASE_URL=https://your-gateway.example.com
# MCAI_API_KEY=
# MCAI_MODEL=your-model

# Where the saved provider config lives. Defaults to ~/.mcai
# MCAI_HOME=

# ── Dashboard ─────────────────────────────────────────────────────────────
MCAI_HTTP_PORT=8765
# Required to reach the API. Set this before exposing the dashboard anywhere:
# it can place blocks and spend tokens.
# MCAI_TOKEN=
