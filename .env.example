# ── Minecraft server ──────────────────────────────────────────────────────
# Enable RCON in server.properties first:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=<the same value as below>
RCON_PASSWORD=change-me
MC_HOST=127.0.0.1
MC_PORT=25565
RCON_PORT=25575
MC_USERNAME=mcAI

# ── Model (optional) ──────────────────────────────────────────────────────
# Any one of these is enough. Without one, library structures still build.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Override the auto-detected provider:
# MCAI_PROVIDER=anthropic
# MCAI_MODEL=claude-sonnet-5
# MCAI_BASE_URL=

# ── Dashboard ─────────────────────────────────────────────────────────────
MCAI_HTTP_PORT=8765
# Required to reach the API. Set this before exposing the dashboard anywhere:
# it can place blocks and spend tokens.
# MCAI_TOKEN=
