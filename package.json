{
  "name": "mcai",
  "version": "5.0.0",
  "description": "Natural-language Minecraft builder. Say what you want, watch it get built — terrain-aware, style-aware, token-cheap.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": {
    "mcai": "dist/cli/main.js",
    "mcai-daemon": "dist/daemon/main.js",
    "mcai-mcp": "dist/mcp/main.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js"
  },
  "files": ["dist", "web", "blueprints", "styles", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:fast": "node --test dist/test/*.test.js",
    "start": "node dist/daemon/main.js",
    "mcp": "node dist/mcp/main.js",
    "sim": "node dist/cli/main.js sim",
    "doctor": "node dist/cli/main.js doctor",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "minecraft", "ai", "llm", "mcp", "model-context-protocol",
    "mineflayer", "rcon", "builder", "voxel", "generative"
  ],
  "dependencies": {
    "mineflayer": "^4.37.1",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
