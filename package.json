{
  "name": "mcai",
  "version": "5.0.0",
  "description": "Natural-language Minecraft builder. Say what you want, watch it get built — terrain-aware, style-aware, token-cheap.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcai": "dist/cli/main.js",
    "mcai-daemon": "dist/daemon/main.js",
    "mcai-mcp": "dist/mcp/main.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "web",
    "blueprints",
    "styles",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "prepare": "node scripts/prepare.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:fast": "node --test dist/test/*.test.js",
    "setup": "node dist/cli/main.js setup",
    "start": "node dist/cli/main.js serve",
    "sim": "node dist/cli/main.js serve --sim",
    "doctor": "node dist/cli/main.js doctor",
    "mcp": "node dist/mcp/main.js",
    "bench": "node dist/cli/main.js bench"
  },
  "keywords": [
    "minecraft",
    "ai",
    "llm",
    "mcp",
    "model-context-protocol",
    "mineflayer",
    "rcon",
    "builder",
    "voxel",
    "generative"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "mineflayer": "^4.37.1",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.0"
  }
}
